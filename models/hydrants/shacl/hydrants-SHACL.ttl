    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "is operated by"@en;
    shacl:path prov:wasAssociatedWith
  ];
  shacl:targetClass <https://saref.etsi.org/saref4watr/Pipe> .

<https://belgif.github.io/thematic/models/hydrants#QuantityValueShape> a shacl:NodeShape;
