    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Unit QuantityValue"@en;
    shacl:path <http://qudt.org/schema/qudt/hasUnit>
  ];
  shacl:targetClass <http://qudt.org/schema/qudt/QuantityValue> .

