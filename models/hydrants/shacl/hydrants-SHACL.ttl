  ], [
    a shacl:PropertyShape;
    rdfs:label "status"@en;
    rdfs:comment "The condition in which a pipe can be found."@en;
    rdfs:seeAlso <https://belgif.github.io/thematic/models/hydrants#Pipe.Status>;
